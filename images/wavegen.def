# DFTools image: wavegen
# Waveform viewers: Surfer (Rust GUI, throwaway rustup toolchain) + GTKWave (GTK3, from
# the gtkwave3-gtk3 tree of the last tagged release; the meson-based rewrite upstream is
# still 4.0.0-prealpha) + WaveCrux (prebuilt upstream AppImage, x86_64 only — closed
# source during its public beta, pinned by version + sha256). GTKWave also brings its
# format converters (vcd2fst, fst2vcd, lxt2vcd, ...). GUI -> needs X11/Wayland/GL + GTK3
# runtime libs (X11-forwarded by the host via Scalapptainer's withX11()).

Bootstrap: docker
From: ubuntu:24.04
Stage: build

%files
    pins.env /opt/pins.env
    build/common.sh /opt/common.sh
    build/strip-runtime.sh /opt/strip-runtime.sh

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export PREFIX=/opt/dftools
    . /opt/pins.env
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates git curl xz-utils pkg-config \
        build-essential cmake gperf \
        libfontconfig-dev libssl-dev \
        libgtk-3-dev libbz2-dev zlib1g-dev
    rm -rf /var/lib/apt/lists/*
    . /opt/common.sh

    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
    . "$HOME/.cargo/env"
    clone https://gitlab.com/surfer-project/surfer "$SURFER_REV" surfer --recursive
    ( cd /src/surfer && cargo build --release --locked -p surfer \
        && install -Dm755 target/release/surfer $PREFIX/bin/surfer )

    # GTKWave: the repo tag holds parallel gtk2/gtk3 trees; build the gtk3 one (ships a
    # pregenerated configure). Tcl integration is disabled to keep tcl/tk out of runtime.
    clone https://github.com/gtkwave/gtkwave "$GTKWAVE_REV" gtkwave
    ( cd /src/gtkwave/gtkwave3-gtk3 \
        && ./configure --prefix=$PREFIX --enable-gtk3 --disable-tcl \
        && make -j"$NPROC" && make install )

    # WaveCrux: upstream ships a prebuilt x86_64-only AppImage (closed-source beta), so
    # this is the second prebuilt exception (with hmi's ffmpeg) — pinned by version +
    # sha256 rather than a source rev. Extracted at build time (no FUSE inside the
    # image; the AppImage bundles its own libs beyond the base X11/GL set) and exposed
    # as `wavecrux`. Skipped on non-x86_64 arches until upstream publishes an aarch64 build.
    if [ "$(uname -m)" = "x86_64" ]; then
        curl -fL -o /src/wavecrux.AppImage \
            "https://updates.wavecrux.app/${WAVECRUX_REV}/WaveCrux-${WAVECRUX_REV}-x86_64.AppImage"
        echo "$WAVECRUX_SHA256  /src/wavecrux.AppImage" | sha256sum -c -
        chmod +x /src/wavecrux.AppImage
        ( cd /src && ./wavecrux.AppImage --appimage-extract >/dev/null )
        mv /src/squashfs-root $PREFIX/wavecrux
        ln -s ../wavecrux/AppRun $PREFIX/bin/wavecrux
    fi

    write_manifest wavegen
    sh /opt/strip-runtime.sh $PREFIX

Bootstrap: docker
From: ubuntu:24.04
Stage: final

%files from build
    /opt/dftools /opt/dftools

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 libgcc-s1 libssl3 \
        libgl1 libx11-6 libxext6 libxrender1 libxi6 libxkbcommon0 \
        libwayland-client0 libfontconfig1 libfreetype6 \
        libgtk-3-0t64 libbz2-1.0 zlib1g
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/dftools/bin:$PATH
    export LD_LIBRARY_PATH=/opt/dftools/lib:/opt/dftools/lib64:$LD_LIBRARY_PATH

%labels
    org.opencontainers.image.title DFTools/wavegen
    org.opencontainers.image.source https://github.com/DFiantHDL/DFTools
    org.opencontainers.image.licenses Apache-2.0

%runscript
    exec "$@"

%test
    set -e
    export PATH=/opt/dftools/bin:$PATH
    surfer --version || true
    gtkwave --version | head -1
    vcd2fst --help >/dev/null 2>&1 || true
    # wavecrux is x86_64-only; GUI startup may still need a display, so tolerate failure
    if [ "$(uname -m)" = "x86_64" ]; then
        command -v wavecrux
        wavecrux --version || true
    fi
